#!/usr/bin/env bash

set -e

DEFAULT_CONFIG_PREFIX="default"
CONFIG_SUFFIX=".conf.yaml"
BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cd "${BASEDIR}"

"${BASEDIR}/scripts/bootstrap-dotbot.sh"

# default.conf.yaml is the workstation shell setup; server profiles use the shared server one instead.
if [[ "${1:-}" == server* ]]; then
  configs=("$@")
else
  configs=("${DEFAULT_CONFIG_PREFIX}" "$@")
fi

for conf in "${configs[@]}"; do
  dotbot \
    -v \
    -d "${BASEDIR}" \
    -c "${conf}${CONFIG_SUFFIX}"
done
