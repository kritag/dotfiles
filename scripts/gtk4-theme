#!/usr/bin/env bash
# gtk4-theme [--no-gsettings] [<Theme>]
#
# libadwaita ignores the gtk-theme gsetting, so the GTK4 theme is whatever
# ~/.config/gtk-4.0/gtk.css imports. This regenerates that file — theme sheet
# first, then sidebar-label-fix.css, which repairs the sidebar/preferences-row
# labels the *-Compact themes paint in the background colour — and relinks
# assets/gtk-dark.css.
#
#   --no-gsettings  only touch ~/.config/gtk-4.0; leave gtk-theme and
#                   color-scheme alone (for callers that set them themselves,
#                   e.g. themeSwitch.sh)
#   no argument     print the current theme and list the installed ones
set -euo pipefail

conf="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0"
theme_dirs=("${XDG_DATA_HOME:-$HOME/.local/share}/themes" "$HOME/.themes" /usr/share/themes)
set_gsettings=1

[ "${1:-}" = "--no-gsettings" ] && { set_gsettings=0; shift; }

# first theme dir that holds a GTK4 sheet for $1
find_sheet() {
  local d
  for d in "${theme_dirs[@]}"; do
    [ -f "$d/$1/gtk-4.0/gtk.css" ] && { echo "$d/$1/gtk-4.0"; return 0; }
  done
  return 1
}

if [ $# -eq 0 ]; then
  sed -n 's|^/\* theme: \(.*\) \*/$|current: \1|p' "$conf/gtk.css" 2>/dev/null || echo "current: unknown"
  echo "installed:"
  for d in "${theme_dirs[@]}"; do
    for sheet in "$d"/*/gtk-4.0/gtk.css; do
      [ -e "$sheet" ] && echo "  $(basename "$(dirname "$(dirname "$sheet")")")"
    done
  done | sort -u
  exit 0
fi

theme=$1
gtk4dir=$(find_sheet "$theme") || {
  echo "gtk4-theme: no GTK4 sheet for '$theme' in ${theme_dirs[*]}" >&2
  exit 1
}
[ -f "$conf/sidebar-label-fix.css" ] || {
  echo "gtk4-theme: $conf/sidebar-label-fix.css is missing" >&2
  exit 1
}

rm -f "$conf/gtk.css" "$conf/gtk-dark.css" "$conf/assets"
cat > "$conf/gtk.css" <<CSS
/* Generated by gtk4-theme. libadwaita ignores the gtk-theme gsetting, so the
   GTK4 theme is whatever this file imports. Run \`gtk4-theme <Theme>\` to switch. */
/* theme: $theme */
@import url("file://$gtk4dir/gtk.css");
@import url("sidebar-label-fix.css");
CSS
[ -e "$gtk4dir/assets" ] && ln -sfn "$gtk4dir/assets" "$conf/assets"
[ -f "$gtk4dir/gtk-dark.css" ] && ln -sfn "$gtk4dir/gtk-dark.css" "$conf/gtk-dark.css"

if [ "$set_gsettings" = 1 ]; then
  # keep GTK3 apps and the shell in step
  gsettings set org.gnome.desktop.interface gtk-theme "$theme"
  case $theme in
    *Light*) gsettings set org.gnome.desktop.interface color-scheme prefer-light ;;
    *) gsettings set org.gnome.desktop.interface color-scheme prefer-dark ;;
  esac
fi

echo "gtk4-theme: $theme (restart GTK4 apps to pick it up)"
