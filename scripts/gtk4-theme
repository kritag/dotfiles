#!/usr/bin/env bash
# gtk4-theme [<Theme>] — point GTK4/libadwaita at a theme in /usr/share/themes
# and layer sidebar-label-fix.css on top. No argument: print the current theme
# and list what is installed.
set -euo pipefail
conf="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0"
themes=/usr/share/themes

if [ $# -eq 0 ]; then
  sed -n 's|^/\* theme: \(.*\) \*/$|current: \1|p' "$conf/gtk.css" 2>/dev/null || echo "current: unknown"
  echo "installed:"
  for d in "$themes"/*/gtk-4.0/gtk.css; do [ -e "$d" ] && echo "  $(basename "$(dirname "$(dirname "$d")")")"; done
  exit 0
fi

theme=$1
sheet="$themes/$theme/gtk-4.0/gtk.css"
[ -f "$sheet" ] || { echo "gtk4-theme: no GTK4 sheet at $sheet" >&2; exit 1; }
[ -f "$conf/sidebar-label-fix.css" ] || { echo "gtk4-theme: $conf/sidebar-label-fix.css is missing" >&2; exit 1; }

rm -f "$conf/gtk.css" "$conf/gtk-dark.css" "$conf/assets"
cat > "$conf/gtk.css" <<CSS
/* Generated by gtk4-theme. libadwaita ignores the gtk-theme gsetting, so the
   GTK4 theme is whatever this file imports. Run \`gtk4-theme <Theme>\` to switch. */
/* theme: $theme */
@import url("file://$sheet");
@import url("sidebar-label-fix.css");
CSS
ln -sfn "$themes/$theme/gtk-4.0/assets" "$conf/assets"
[ -f "$themes/$theme/gtk-4.0/gtk-dark.css" ] && ln -sfn "$themes/$theme/gtk-4.0/gtk-dark.css" "$conf/gtk-dark.css"

# keep GTK3 apps and the shell in step
gsettings set org.gnome.desktop.interface gtk-theme "$theme"
case $theme in
  *Light*) gsettings set org.gnome.desktop.interface color-scheme prefer-light ;;
  *)       gsettings set org.gnome.desktop.interface color-scheme prefer-dark ;;
esac

echo "gtk4-theme: $theme (restart GTK4 apps to pick it up)"
