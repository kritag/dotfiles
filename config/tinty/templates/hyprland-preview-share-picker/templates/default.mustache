/* Autogenerated by tinty. Do not edit by hand. */
/* One accent (base0B); greys only otherwise. base02 is tinted in some schemes
   (everforest: purple), so the hover grey is mixed from surface + fg instead. */
@define-color bg #{{base00-hex}};
@define-color surface #{{base01-hex}};
@define-color overlay mix(@surface, @fg, 0.12);
@define-color muted #{{base04-hex}};
@define-color fg #{{base05-hex}};
@define-color accent #{{base0B-hex}};

* {
  all: unset;
  font-family: "@@FONT@@", sans-serif;
  color: @fg;
  font-size: 15px;
}

.window {
  background-color: @bg;
  border: solid 2px @accent;
  border-radius: 10px;
  margin: 4px;
  padding: 18px;
}

tabs {
  padding: 0.5rem 1rem;
}

tabs > tab {
  margin-right: 1.5rem;
  padding-bottom: 4px;
  border-bottom: solid 2px transparent;
  transition: all 0.15s ease;
}

tabs > tab:hover {
  border-bottom-color: @overlay;
}

tabs > tab:checked {
  border-bottom-color: @accent;
}

.tab-label {
  color: @muted;
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 2px;
  text-transform: uppercase;
  transition: color 0.15s ease;
}

tabs > tab:hover > .tab-label, tabs > tab:checked > .tab-label {
  color: @fg;
}

.page {
  padding: 1rem;
}

.image-label {
  color: @muted;
  font-size: 12px;
  padding: 0.25rem;
  transition: color 0.15s ease;
}

flowboxchild > .card, button > .card {
  transition: all 0.15s ease;
  border: solid 2px @surface;
  border-radius: 8px;
  background-color: @surface;
  padding: 6px;
}

flowboxchild:hover > .card, button:hover > .card {
  border-color: @overlay;
  background-color: @overlay;
}

flowboxchild:selected > .card, flowboxchild:focus > .card, button:focus > .card, flowboxchild:active > .card, button:active > .card {
  border-color: @accent;
}

flowboxchild:hover .image-label, button:hover .image-label, flowboxchild:focus .image-label, button:focus .image-label {
  color: @fg;
}

.card-loading {
  opacity: 0.5;
}

.image {
  border-radius: 5px;
}

/* all: unset strips the scrollbar to zero size; give the slider a body again */
scrollbar slider {
  min-width: 6px;
  min-height: 6px;
  border-radius: 3px;
  background-color: @overlay;
}

scrollbar slider:hover, scrollbar slider:active {
  background-color: @muted;
}

.region-button {
  padding: 0.5rem 1rem;
  border-radius: 6px;
  background-color: @accent;
  color: @bg;
  font-weight: bold;
  transition: all 0.15s ease;
}

.region-button > label {
  color: @bg;
}

.region-button:not(:disabled):hover, .region-button:not(:disabled):focus {
  background-color: mix(@accent, @fg, 0.3);
}

.region-button:disabled {
  background-color: @overlay;
  color: @muted;
}
