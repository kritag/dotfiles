{{! Colours outside chroma are ANSI slots, not hex: in a pipe (fzf-tab previews) glow only emits the
    16 ANSI colours and mangles hex ones. Slots follow the terminal theme. base05 (null) = terminal fg.
    chroma must stay hex. }}
{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": null,
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": null,
    "bold": true
  },
  "h1": {
    "prefix": "▓▓▓ ",
    "suffix": " ",
    "color": "1",
    "bold": true
  },
  "h2": {
    "prefix": "▓▓▓▓ ",
    "color": "3"
  },
  "h3": {
    "prefix": "▓▓▓▓▓ ",
    "color": "3"
  },
  "h4": {
    "prefix": "▓▓▓▓▓▓ ",
    "color": "2"
  },
  "h5": {
    "prefix": "▓▓▓▓▓▓▓ ",
    "color": "6"
  },
  "h6": {
    "prefix": "▓▓▓▓▓▓▓▓ ",
    "color": "4"
  },
  "text": { },
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "4",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "4",
    "underline": true
  },
  "link_text": {
    "color": "5",
    "bold": true
  },
  "image": {
    "color": "4",
    "underline": true
  },
  "image_text": {
    "color": "5",
    "format": "Image: {.text} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "7",
    "background_color": "0"
  },
  "code_block": {
    "color": "0",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#{{base05-hex}}"
      },
      "error": {
        "color": "#{{base05-hex}}",
        "background_color": "#{{base08-hex}}"
      },
      "comment": {
        "color": "#{{base0D-hex}}"
      },
      "comment_preproc": {
        "color": "#{{base0D-hex}}"
      },
      "keyword": {
        "color": "#{{base03-hex}}"
      },
      "keyword_reserved": {
        "color": "#{{base03-hex}}"
      },
      "keyword_namespace": {
        "color": "#{{base09-hex}}"
      },
      "keyword_type": {
        "color": "#{{base09-hex}}"
      },
      "operator": {
        "color": "#{{base0C-hex}}"
      },
      "punctuation": {
        "color": "#{{base0F-hex}}"
      },
      "name": {
        "color": "#{{base0D-hex}}"
      },
      "name_builtin": {
        "color": "#{{base0A-hex}}"
      },
      "name_tag": {
        "color": "#{{base03-hex}}"
      },
      "name_attribute": {
        "color": "#{{base09-hex}}"
      },
      "name_class": {
        "color": "#{{base09-hex}}"
      },
      "name_constant": {
        "color": "#{{base09-hex}}"
      },
      "name_decorator": {
        "color": "#{{base0E-hex}}"
      },
      "name_exception": { },
      "name_function": {
        "color": "#{{base0D-hex}}"
      },
      "name_other": { },
      "literal": { },
      "literal_number": {
        "color": "#{{base0A-hex}}"
      },
      "literal_date": { },
      "literal_string": {
        "color": "#{{base0B-hex}}"
      },
      "literal_string_escape": {
        "color": "#{{base0E-hex}}"
      },
      "generic_deleted": {
        "color": "#{{base08-hex}}"
      },
      "generic_emph": {
        "color": "#{{base05-hex}}",
        "italic": true
      },
      "generic_inserted": {
        "color": "#{{base0B-hex}}"
      },
      "generic_strong": {
        "color": "#{{base05-hex}}",
        "bold": true
      },
      "generic_subheading": {
        "color": "#{{base0C-hex}}"
      },
      "background": {
        "background_color": "#{{base00-hex}}"
      }
    }
  },
  "table": {
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  },
  "definition_list": { },
  "definition_term": { },
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": { },
  "html_span": { }
}

