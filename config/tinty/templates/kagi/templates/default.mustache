}

/* Privacy Popover */
#popover-privacy > p:nth-child(3) > span > i {
    color: var(--base11) !important;
}

/* Search Results */
.search-result,
.sri-group {
    border-bottom: unset !important;
}
.inline-content + .search-result,
.inline-content + .sri-group {
    border-top: unset !important;
}
.s-f-w.--active .search_area {
    padding: 10px !important;
}
.main-center-box > * {
    margin-inline: auto;
    max-width: 850px;
    padding-inline: 16px;
    width: 100%;
}
.__sri-title .__sri_title_link,
.__sri-title .__sri_title_link:hover {
    border-bottom: 1px solid transparent !important;
    font-weight: inherit;
    padding: 0;
    transform: none;
}
.__sri-title .__sri_title_link:hover {
    border-bottom-color: var(--primary-hover) !important;
}

/* Background Crust Overrides */
#thread-sidebar-visible:checked ~ #sidebar-backdrop,
.quick-settings,
.quick-settings-footer,
.promptOptionsSelector,
.promptOptionsSelector .search-bar,
.k_ui_dropdown_data_list,
._0_more_search_box,
.dropdown .dd-list,
.chat_bubble .actions,
.citation,
.message-info,
.thread-more-menu,
.threads-pane {
    background-color: var(--base11) !important;
}

/* Lenses */
._0_lenses {
    background-color: unset !important;
}

/* Mobile Internet Access */
#internet-access-mobile:has(:checked) {
    color: var(--base01);
}

/* Team Badge */
.team_badge {
    color: var(--base11);
}

/* Image Preview */
#PreviewImageViewImageBtn,
#PreviewImageViewPageBtn {
    color: unset !important;
}

/* Media Queries */
@media (min-width: 1280px) {
    #promptBox:placeholder-shown + .rich-placeholder {
        padding-left: 25px;
    }
}

@media all and (min-device-width: 766px) {
    form#form {
        margin: 0;
        border: 1px var(--base09) solid;
        border-radius: 35px;
        padding: 12px 20px;
    }
    ._0_more_search_box {
        max-width: 300px;
        width: unset;
    }
    .app-content-box {
        /* the element was header.app-header.app-content-box */
        max-width: none;
    }
}

@media all and (max-device-width: 766px) {
    .cluster section.did-you-know {
        background-color: var(--box-shadow-15);
    }
    .cluster section.perspectives ul li {
        background-color: var(--ai_chat_buble_a_bg);
    }
    .cluster .cluster-header .badge {
        background-color: var(--accent-info);
    }
    .bg-p-50 {
        background-color: var(--base01);
    }
    body:not(._0_processing)
        #form:has(#promptBox:placeholder-shown):has(#uploadedItems:empty)
        #submit {
        color: var(--base01);
    }
    .landing-category-select .landing_cat_buttons > button.--active {
        align-items: center;
        border: 1px solid var(--primary-400);
        border-radius: 999px;
        color: var(--primary-500);
        display: flex;
        flex-shrink: 0;
        gap: 4px;
        padding: 8px 16px;
        background-color: var(--base01);
        font-weight: 700;
    }
    .landing-category-select .landing_cat_buttons > button {
        border: 0;
        color: var(--primary);
        font-size: 0.875rem;
        height: 47px;
        margin: 0;
        min-width: unset !important;
        padding: 0 8px;
        position: relative;
    }
    #thread-sidebar-visible:checked ~ #sidebar-backdrop {
        background-color: unset !important;
    }
    .chat_bubble .actions,
    .editing .actions {
        border-radius: 10%;
        color: var(--primary-600);
        display: flex;
        padding: 4px;
    }
    .landing_cat_buttons {
        border-bottom: 0 !important;
        display: flex;
        justify-content: space-between;
        width: 100%;
    }
    #adv_search_btn:checked
        + #mainContent
        .search-form
        .landing-category-select {
        top: 85px;
    }
}
circle.clock {
    fill: rgb(150, 120, 120);
}
