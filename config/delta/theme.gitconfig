[delta "delta-theme"]
	blame-palette = "#2b3339 #323c41 #2b3339 #503946 #859289"
	commit-decoration-style = "#83c092" box
	dark = true
	file-decoration-style = "#83c092" overline
	file-style = bold "#d3c6aa" "#323c41"
	right-arrow = "->"
	hunk-header-decoration-style = "#83c092" box
	hunk-header-file-style = bold "#83c092"
	hunk-header-line-number-style = bold "#9da9a0"
	hunk-header-style = omit
	line-numbers = true
	line-numbers-left-format = "│{nm:^4}│"
	line-numbers-right-format = "│{np:^4}│"
	line-numbers-left-style = "#859289"
	line-numbers-minus-style = bold "#e67e80"
	line-numbers-plus-style = bold "#a7c080"
	line-numbers-right-style = "#859289"
	line-numbers-zero-style = "#859289"
	minus-emph-style = bold syntax "#6c4d52"
	minus-style = syntax "#504247"
	plus-emph-style = bold syntax "#566452"
	plus-style = syntax "#444f47"
	map-styles = \
		bold purple => syntax "#675765", \
		bold blue => syntax "#486364", \
		bold cyan => syntax "#4a6458", \
		bold yellow => syntax "#696352"
	whitespace-error-style = "#e67e80" reverse
	file-added-label = [●]
	file-copied-label = [C]
	file-modified-label = [+]
	file-removed-label = [✗]
	file-renamed-label = [->]
  syntax-theme = everforest-dark
