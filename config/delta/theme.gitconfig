[delta "delta-theme"]
	blame-palette = "#2b3339 #323c41 #2b3339 #503946 #859289"
	commit-decoration-style = box ul
	dark = true
	file-decoration-style = "#d3c6aa"
	file-style = "#d3c6aa"
	hunk-header-decoration-style = box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#9da9a0"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#859289"
	line-numbers-minus-style = bold "#e67e80"
	line-numbers-plus-style = bold "#a7c080"
	line-numbers-right-style = "#859289"
	line-numbers-zero-style = "#859289"
	minus-emph-style = bold syntax "#6e4b53"
	minus-style = syntax "#503946"
	plus-emph-style = bold syntax "#4f6150"
	plus-style = syntax "#3c4841"
	map-styles = \
		bold purple => syntax "#494060", \
		bold blue => syntax "#384361", \
		bold cyan => syntax "#384d5d", \
		bold yellow => syntax "#544f4e"
  syntax-theme =