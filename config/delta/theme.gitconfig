[delta "delta-theme"]
	blame-palette = "#2b3339 #323c41 #2b3339 #503946 #859289"
	commit-decoration-style = box ul
	dark = true
	file-decoration-style = "#d3c6aa"
	file-style = "#d3c6aa"
	hunk-header-decoration-style = box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#9da9a0"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#859289"
	line-numbers-minus-style = bold "#e67e80"
	line-numbers-plus-style = bold "#a7c080"
	line-numbers-right-style = "#859289"
	line-numbers-zero-style = "#859289"
	minus-emph-style = bold syntax "#765155"
	minus-style = syntax "#504247"
	plus-emph-style = bold syntax "#5d6b55"
	plus-style = syntax "#444f47"
	map-styles = \
		bold purple => syntax "#4d4752", \
		bold blue => syntax "#3c4e51", \
		bold cyan => syntax "#3d4f4b", \
		bold yellow => syntax "#4e4e47"
	file-added-label = [●]
	file-copied-label = [C]
	file-modified-label = [+]
	file-removed-label = [✗]
	file-renamed-label = [→]
  syntax-theme = everforest-dark