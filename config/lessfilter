#!/usr/bin/env bash
mime=$(file -Lbs --mime-type "$1")
category=${mime%%/*}
kind=${mime##*/}
ext=${1##*.}
if [ -d "$1" ]; then
  eza -l --color=always --no-time --git --icons --group-directories-first "$1"
elif [[ "$1" == *.zip ]]; then # lesspipe misses zips that `file` calls octet-stream
  unzip -l "$1"
elif [[ "$1" == *.md ]]; then # glow ignores $GLOW_STYLE in a pipe, so pass it with -s
  glow -s "$GLOW_STYLE" ${FZF_PREVIEW_COLUMNS:+-w "$FZF_PREVIEW_COLUMNS"} "$1" </dev/null
elif [ "$kind" = pdf ]; then
  pdftotext -q "$1" - | sed $'s/\f/──────────\\n/g'
elif [ "$kind" = vnd.sqlite3 ]; then
  sqlite3 -readonly "$1" .schema | bat --style="changes" --color=always -l sql
elif [ "$category" = image ]; then
  fzf-preview.sh "$1"
elif [ "$kind" = json ]; then
  bat --style="changes" --color=always -l json "$1"
elif [ "$kind" = javascript ]; then
  bat --style="changes" --color=always -l js "$1"
elif [ "$ext" = lua ]; then
  bat --style="changes" --color=always -l lua "$1"
elif [ "$category" = text ]; then
  bat --style="changes" --color=always "$1"
else
  exit 1 # not handled here: lesspipe falls back to its own handlers (archives etc.)
fi
