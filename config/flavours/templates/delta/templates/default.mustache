[delta "delta-theme"]
	blame-palette = "#{{base00-hex}} #{{base01-hex}} #{{base00-hex}} #{{base02-hex}} #{{base03-hex}}"
	commit-decoration-style = box ul
	dark = true
	file-decoration-style = "#{{base05-hex}}"
	file-style = "#{{base05-hex}}"
	hunk-header-decoration-style = box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#{{base04-hex}}"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#{{base03-hex}}"
	line-numbers-minus-style = bold "#{{base08-hex}}"
	line-numbers-plus-style = bold "#{{base0B-hex}}"
	line-numbers-right-style = "#{{base03-hex}}"
	line-numbers-zero-style = "#{{base03-hex}}"
	minus-emph-style = bold syntax "@mix:{{base00-hex}}:{{base08-hex}}:40@"
	minus-style = syntax "@mix:{{base00-hex}}:{{base08-hex}}:20@"
	plus-emph-style = bold syntax "@mix:{{base00-hex}}:{{base0B-hex}}:40@"
	plus-style = syntax "@mix:{{base00-hex}}:{{base0B-hex}}:20@"
	map-styles = \
		bold purple => syntax "@mix:{{base00-hex}}:{{base0E-hex}}:20@", \
		bold blue => syntax "@mix:{{base00-hex}}:{{base0D-hex}}:20@", \
		bold cyan => syntax "@mix:{{base00-hex}}:{{base0C-hex}}:20@", \
		bold yellow => syntax "@mix:{{base00-hex}}:{{base0A-hex}}:20@"
	file-added-label = [●]
	file-copied-label = [C]
	file-modified-label = [+]
	file-removed-label = [✗]
	file-renamed-label = [→]
  syntax-theme = everforest-dark
