#!/usr/bin/zsh
# zmodload zsh/zprof
source "$HOME/.aliases.zsh"
source "$HOME/.env"
source "$HOME/.zshkeybindings.zsh"
PATH="${PATH}:$HOME/bin:$HOME/.local/bin:$HOME/.krew/bin:$HOME/.npm-global/bin/:$HOME/.fluxcd/plugins/"
export PATH

setopt APPEND_HISTORY EXTENDED_HISTORY HIST_EXPIRE_DUPS_FIRST HIST_FIND_NO_DUPS \
  HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS HIST_SAVE_NO_DUPS HIST_VERIFY SHARE_HISTORY

# LS_COLORS from vivid, cached. Rebuilt when the theme file is newer; themeSwitch.sh edits the path and deletes the cache.
_vivid_theme=~/.config/vivid/themes/everforest.yaml
_ls_colors_cache="$ZSH_CACHE_DIR/ls_colors"
if [[ ! -s $_ls_colors_cache || $_vivid_theme -nt $_ls_colors_cache ]]; then
  vivid generate $_vivid_theme >$_ls_colors_cache.tmp && mv $_ls_colors_cache.tmp $_ls_colors_cache || rm -f $_ls_colors_cache.tmp
fi
[[ -s $_ls_colors_cache ]] && export LS_COLORS="$(<$_ls_colors_cache)"
unset _vivid_theme _ls_colors_cache

ZNAP_DIR="${ZNAP_DIR:-$HOME/git/znap/znap}"
if [[ ! -r "$ZNAP_DIR/znap.zsh" ]]; then
  mkdir -p "${ZNAP_DIR:h}"
  git clone --depth 1 -- \
    https://github.com/marlonrichert/zsh-snap.git "$ZNAP_DIR"
fi

source "$ZNAP_DIR/znap.zsh"
znap source ohmyzsh/ohmyzsh plugins/dirhistory
znap source ajeetdsouza/zoxide
znap source Aloxaf/fzf-tab
znap source zsh-users/zsh-autosuggestions
znap source zsh-users/zsh-history-substring-search

[[ -f "$HOME/.config/tinted-theming/generated/fzf.sh" ]] && source "$HOME/.config/tinted-theming/generated/fzf.sh"
if [[ -f /usr/share/fzf/key-bindings.zsh ]]; then
  source /usr/share/fzf/key-bindings.zsh
elif [[ -f /usr/share/fzf/shell/key-bindings.zsh ]]; then
  source /usr/share/fzf/shell/key-bindings.zsh
fi

# Optional: fzf completion (may not exist on Fedora)
if [[ -f /usr/share/fzf/completion.zsh ]]; then
  source /usr/share/fzf/completion.zsh
fi

compdef _kubectl kubecolor
# Make autocomplete work for the jctl() function
compdef _journalctl jctl
compdef _zr zr
# Sourcing k8s related stuff if using k8s
#if command -v kubectl &> /dev/null
#then
#    source $HOME/.functions_k8s
#fi

eval "$(zsh-patina activate)"
znap eval oh-my-posh 'oh-my-posh init zsh --config $HOME/.config/oh-my-posh/omp.yaml'

# Re-render the oh-my-posh prompt at the new width after a terminal resize.
# Its right-aligned segments are padded to the width at render time, so without
# this they stay where they were. $? is saved so the prompt colour survives.
typeset -g _omp_winch_status=0
_omp_save_status() { _omp_winch_status=$?; }
precmd_functions=(_omp_save_status ${precmd_functions:#_omp_save_status})
TRAPWINCH() {
  zle || return 0
  (exit $_omp_winch_status)
  _omp_precmd
  zle reset-prompt
}

source $HOME/.zstyle.zsh
# Ensure up and down arrow works for searching history
bindkey '^[0A' history-substring-search-up
bindkey '^[0B' history-substring-search-down
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
znap prompt
# zprof
