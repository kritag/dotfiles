_name="WowAdder"
pkgname="wow-adder"
pkgver=26.9.1
pkgrel=1
pkgdesc="A Tauri app for managing World of Warcraft addons, repackaged from the upstream .deb."
arch=('x86_64')
url="https://github.com/TheGloved1/${_name}"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3')
options=('!strip')
source=("${_name}-${pkgver}.deb::${url}/releases/download/v${pkgver}/${_name}_${pkgver}_amd64.deb"
        "LICENSE-${pkgver}::https://raw.githubusercontent.com/TheGloved1/${_name}/v${pkgver}/LICENSE")
noextract=("${_name}-${pkgver}.deb")
sha256sums=('589bbcc16969586ef974dd7a2637a4f42a434209eed8183eb4ac50485ba6027f'
            'SKIP')

prepare() {
  bsdtar -xf "${_name}-${pkgver}.deb" data.tar.gz
  mkdir -p root
  bsdtar -xf data.tar.gz -C root
}

package() {
  cp -a root/usr "${pkgdir}/usr"
  # the deb's "256x256@2" dir holds a plain 256px icon; hicolor has no such name
  mv "${pkgdir}/usr/share/icons/hicolor/256x256@2" "${pkgdir}/usr/share/icons/hicolor/256x256"
  install -Dm644 "LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
